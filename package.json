{
  "name": "extreme-tweaker",
  "version": "1.0.4-beta",
  "description": "Anton Vampire — Windows optimizer",
  "main": "main.js",
  "author": "Anton18-PNG",
  "homepage": "https://anton18-png.github.io/Anton-Vampire/web/index.html",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.5.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/ubuntu-sans": "^5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "build": {
    "appId": "com.extreme.tweaker",
    "productName": "Anton Vampire",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Anton Vampire"
    },
    "files": [
      "**/*",
      "!BackUp/**",
      "!dist/**",
      "!node_modules/**",
      "!extreme_data/**",
      "!user_data/**",
      "!logs/**",
      "!web/**",
      "!tools/**",
      "!tweaks/**",
      "!Utils/**",
      "src/assets/fonts/**/*"
    ],
    "extraResources": [
      {
        "from": "tweaks",
        "to": "tweaks"
      },
      {
        "from": "Utils",
        "to": "Utils"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "src",
        "to": "src"
      }
    ]
  }
}