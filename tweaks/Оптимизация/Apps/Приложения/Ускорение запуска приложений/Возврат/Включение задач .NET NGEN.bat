@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ВКЛЮЧЕНИЕ ЗАДАЧ .NET NGEN
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает обратно задачи NGEN (Native Image Generator) для оптимизации
echo .NET приложений.
echo.
echo Включаемые задачи:
echo   - .NET Framework NGEN v4.0.30319
echo   - .NET Framework NGEN v4.0.30319 64
echo   - .NET Framework NGEN v4.0.30319 64 Critical
echo   - .NET Framework NGEN v4.0.30319 Critical
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] .NET приложения запускаются быстрее
echo [+] Первый запуск приложений оптимизируется
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Увеличивается фоновая нагрузка на CPU
echo [-] Задачи NGEN работают в фоне при простое системы
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запускайте если заметили медленный запуск .NET приложений
echo [2] Это стандартные настройки Windows
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319" /enable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 64" /enable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 64 Critical" /enable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 Critical" /enable >nul 2>&1

echo.
echo ================================================================================
echo                    ГОТОВО! ЗАДАЧИ .NET NGEN ВКЛЮЧЕНЫ
echo ================================================================================

echo.