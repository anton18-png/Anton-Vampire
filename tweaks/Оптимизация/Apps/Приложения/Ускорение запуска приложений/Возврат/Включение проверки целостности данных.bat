@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ВКЛЮЧЕНИЕ ПРОВЕРКИ ЦЕЛОСТНОСТИ ДАННЫХ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает обратно задачи проверки целостности системных файлов
echo и сканирования диска на наличие ошибок.
echo.
echo Включаемые задачи:
echo   - Data Integrity Check And Scan
echo   - Data Integrity Scan
echo   - Data Integrity Scan for Crash Recovery
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Система автоматически проверяет целостность файлов
echo [+] Ошибки диска обнаруживаются вовремя
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Увеличивается фоновая нагрузка на диск и CPU
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запускайте если важна своевременная диагностика ошибок диска
echo [2] Это стандартная настройка Windows
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Check And Scan" /enable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Scan" /enable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Scan for Crash Recovery" /enable >nul 2>&1

echo.
echo ================================================================================
echo               ГОТОВО! ПРОВЕРКА ЦЕЛОСТНОСТИ ДАННЫХ ВКЛЮЧЕНА
echo ================================================================================

echo.