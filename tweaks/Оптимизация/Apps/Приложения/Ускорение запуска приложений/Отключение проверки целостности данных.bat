@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ ПРОВЕРКИ ЦЕЛОСТНОСТИ ДАННЫХ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Data Integrity Scan - проверяет целостность системных файлов
echo и сканирует диск на наличие ошибок в фоновом режиме.
echo.
echo Отключаемые задачи:
echo   - Data Integrity Check And Scan
echo   - Data Integrity Scan
echo   - Data Integrity Scan for Crash Recovery
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ ФОНОВУЮ НАГРУЗКУ НА ДИСК И CPU
echo [+] УМЕНЬШАЕТ ЗАПИСЬ НА SSD (увеличивает срок службы)
echo [+] УСКОРЯЕТ РАБОТУ СИСТЕМЫ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Система не проверяет целостность файлов автоматически
echo [-] Ошибки диска могут быть не обнаружены вовремя
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для SSD дисков и мощных ПК
echo [2] На ноутбуках экономит батарею
echo [3] Для возврата используйте скрипт "Включение проверки целостности данных.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Check And Scan" /disable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Scan" /disable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\Data Integrity Scan\Data Integrity Scan for Crash Recovery" /disable >nul 2>&1

echo.
echo ================================================================================
echo               ГОТОВО! ПРОВЕРКА ЦЕЛОСТНОСТИ ДАННЫХ ОТКЛЮЧЕНА
echo ================================================================================

echo.