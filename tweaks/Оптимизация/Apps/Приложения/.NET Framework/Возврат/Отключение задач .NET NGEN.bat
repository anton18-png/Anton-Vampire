@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ ЗАДАЧ .NET NGEN
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo NGEN (Native Image Generator) - создает нативные образы .NET сборок.
echo Это полезно для ускорения запуска приложений, но задачи NGEN работают
echo в фоне и потребляют ресурсы процессора.
echo.
echo Отключаются следующие задачи:
echo   - .NET Framework NGEN v4.0.30319
echo   - .NET Framework NGEN v4.0.30319 64
echo   - .NET Framework NGEN v4.0.30319 64 Critical
echo   - .NET Framework NGEN v4.0.30319 Critical
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ ФОНОВУЮ НАГРУЗКУ НА CPU (до 10-20%)
echo [+] УМЕНЬШАЕТ ПОТРЕБЛЕНИЕ ОПЕРАТИВНОЙ ПАМЯТИ
echo [+] УСКОРЯЕТ ЗАГРУЗКУ СИСТЕМЫ
echo [+] ПОВЫШАЕТ ПРОИЗВОДИТЕЛЬНОСТЬ В ИГРАХ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] .NET приложения могут запускаться чуть дольше (на 1-3 секунды)
echo [-] Первый запуск приложений после очистки может быть медленнее
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo [3] На мощных ПК разница в производительности незаметна
echo [4] Для возврата используйте скрипт "Включение задач .NET NGEN.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319" /disable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 64" /disable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 64 Critical" /disable >nul 2>&1
schtasks /change /tn "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 Critical" /disable >nul 2>&1

echo.
echo ================================================================================
echo                    ГОТОВО! ЗАДАЧИ .NET NGEN ОТКЛЮЧЕНЫ
echo ================================================================================

echo.