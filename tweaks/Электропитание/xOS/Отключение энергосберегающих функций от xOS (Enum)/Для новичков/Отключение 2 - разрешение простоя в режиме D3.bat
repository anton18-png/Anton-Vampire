@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    РАЗРЕШЕНИЯ ПРОСТОЯ В СОСТОЯНИИ D3
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo AllowIdleIrpInD3 - разрешает драйверам отправлять IRP-пакеты когда устройство
echo находится в состоянии сна D3.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Уменьшает фоновую активность драйверов в простое
echo [+] Снижает нагрузку на систему
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Устройства могут дольше просыпаться
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "AllowIdleIrpInD3"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "AllowIdleIrpInD3" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                  ГОТОВО! РАЗРЕШЕНИЕ ПРОСТОЯ В D3 ОТКЛЮЧЕНО
echo ================================================================================

echo.