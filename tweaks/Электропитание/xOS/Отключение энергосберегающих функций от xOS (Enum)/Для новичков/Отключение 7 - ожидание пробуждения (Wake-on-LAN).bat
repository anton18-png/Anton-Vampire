@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    ОЖИДАНИЯ ПРОБУЖДЕНИЯ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo WaitWakeEnabled - позволяет устройствам пробуждать систему из сна.
echo При отключении устройства НЕ могут разбудить компьютер.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Предотвращает случайные пробуждения компьютера
echo [+] Снижает энергопотребление в режиме сна
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Нельзя разбудить ПК мышью или клавиатурой
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "WaitWakeEnabled"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "WaitWakeEnabled" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                   ГОТОВО! ОЖИДАНИЕ ПРОБУЖДЕНИЯ ОТКЛЮЧЕНО
echo ================================================================================

echo.