@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ USB
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo EnableSelectiveSuspend - включает выборочное отключение USB-устройств.
echo При отключении USB-устройства никогда не засыпают.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] УСТРАНЯЕТ ЗАДЕРЖКИ МЫШИ после бездействия
echo [+] Геймпады не "отваливаются" в играх
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] USB-устройства потребляют энергию постоянно
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnableSelectiveSuspend"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnableSelectiveSuspend" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                 ГОТОВО! ВЫБОРОЧНОЕ ОТКЛЮЧЕНИЕ USB ОТКЛЮЧЕНО
echo ================================================================================

echo.