@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ
echo                    ПРОСТОЯ В РАБОЧЕМ СОСТОЯНИИ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает возможность простоя устройств во время работы (значение 1).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства могут экономить энергию даже когда система работает
echo [+] На ноутбуках увеличивает время автономной работы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Могут вернуться микро-задержки при активации устройств
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "IdleInWorkingState"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "IdleInWorkingState" /t REG_DWORD /d "1" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                  ГОТОВО! ПРОСТОЙ В РАБОЧЕМ СОСТОЯНИИ ВКЛЮЧЕН
echo ================================================================================

echo.