@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ
echo                    РАСШИРЕННОГО УПРАВЛЕНИЯ ПИТАНИЕМ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает расширенное управление питанием обратно (значение 1).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Возвращает стандартное поведение Windows
echo [+] Восстанавливает энергосбережение для устройств
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Нет минусов - это возврат к настройкам по умолчанию
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnhancedPowerManagementEnabled"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnhancedPowerManagementEnabled" /t REG_DWORD /d "1" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo              ГОТОВО! РАСШИРЕННОЕ УПРАВЛЕНИЕ ПИТАНИЕМ ВКЛЮЧЕНО
echo ================================================================================

echo.