@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ
echo                    ОСНОВНОГО МЕХАНИЗМА ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает основной механизм выборочного отключения USB (значение 1).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Полностью восстанавливает USB энергосбережение
echo [+] На ноутбуках батарея будет дольше работать
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Могут вернуться задержки USB после бездействия
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "SelectiveSuspendEnabled"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "SelectiveSuspendEnabled" /t REG_DWORD /d "1" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo             ГОТОВО! ОСНОВНОЙ МЕХАНИЗМ ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ ВКЛЮЧЕН
echo ================================================================================

echo.