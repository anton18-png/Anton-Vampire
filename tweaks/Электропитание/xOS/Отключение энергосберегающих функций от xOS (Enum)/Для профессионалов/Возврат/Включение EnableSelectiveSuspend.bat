@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ
echo                    ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ USB
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает выборочное отключение USB-устройств обратно (значение 1).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Восстанавливает энергосбережение USB
echo [+] На ноутбуках увеличивает время автономной работы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Могут вернуться задержки мыши после бездействия
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnableSelectiveSuspend"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnableSelectiveSuspend" /t REG_DWORD /d "1" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                 ГОТОВО! ВЫБОРОЧНОЕ ОТКЛЮЧЕНИЕ USB ВКЛЮЧЕНО
echo ================================================================================

echo.