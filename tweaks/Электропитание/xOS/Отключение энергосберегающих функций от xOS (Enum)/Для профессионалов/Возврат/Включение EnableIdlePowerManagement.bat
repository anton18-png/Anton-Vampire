@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ
echo                    УПРАВЛЕНИЯ ПИТАНИЕМ В ПРОСТОЕ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Включает управление питанием в режиме простоя (значение 1).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства могут экономить энергию когда не используются
echo [+] На ноутбуках увеличивает время автономной работы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Могут вернуться задержки при активации устройств
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnableIdlePowerManagement"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnableIdlePowerManagement" /t REG_DWORD /d "1" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo               ГОТОВО! УПРАВЛЕНИЕ ПИТАНИЕМ В ПРОСТОЕ ВКЛЮЧЕНО
echo ================================================================================

echo.