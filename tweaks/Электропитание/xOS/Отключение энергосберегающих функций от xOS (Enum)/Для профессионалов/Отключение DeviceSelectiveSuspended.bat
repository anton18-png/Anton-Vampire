@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ УСТРОЙСТВ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo DeviceSelectiveSuspended - показывает находится ли устройство в состоянии
echo выборочного отключения.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства не маркируются как "отключенные"
echo [+] Устройства всегда активны
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Повышенное энергопотребление
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "DeviceSelectiveSuspended"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "DeviceSelectiveSuspended" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo              ГОТОВО! ВЫБОРОЧНОЕ ОТКЛЮЧЕНИЕ УСТРОЙСТВ ОТКЛЮЧЕНО
echo ================================================================================

echo.