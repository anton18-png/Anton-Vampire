@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    РАСШИРЕННОГО УПРАВЛЕНИЯ ПИТАНИЕМ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo EnhancedPowerManagementEnabled - отключает расширенное управление питанием.
echo При отключении устройства не используют энергосберегающие режимы.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства работают стабильнее, без "засыпания"
echo [+] Убирает задержки при пробуждении
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Увеличивает энергопотребление в простое
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnhancedPowerManagementEnabled"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnhancedPowerManagementEnabled" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo              ГОТОВО! РАСШИРЕННОЕ УПРАВЛЕНИЕ ПИТАНИЕМ ОТКЛЮЧЕНО
echo ================================================================================

echo.