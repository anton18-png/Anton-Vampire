@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    ОСНОВНОГО МЕХАНИЗМА ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo SelectiveSuspendEnabled - основной параметр выборочного отключения USB.
echo При отключении полностью отключает механизм усыпления USB.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ПОЛНОСТЬЮ ОТКЛЮЧАЕТ USB ЭНЕРГОСБЕРЕЖЕНИЕ
echo [+] Решает 99%% проблем с задержками USB
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Постоянное энергопотребление USB
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "SelectiveSuspendEnabled"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "SelectiveSuspendEnabled" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo             ГОТОВО! ОСНОВНОЙ МЕХАНИЗМ ВЫБОРОЧНОГО ОТКЛЮЧЕНИЯ ОТКЛЮЧЕН
echo ================================================================================

echo.