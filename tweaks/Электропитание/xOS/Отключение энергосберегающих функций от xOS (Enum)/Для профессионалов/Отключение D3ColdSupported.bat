@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    ХОЛОДНОГО СОСТОЯНИЯ D3
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo D3ColdSupported - поддержка полного отключения питания устройства.
echo При отключении устройство не переходит в состояние полного отключения.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства просыпаются МГНОВЕННО
echo [+] Нет задержек при выходе из сна
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Увеличивает энергопотребление в режиме сна
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "D3ColdSupported"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "D3ColdSupported" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo                   ГОТОВО! ХОЛОДНОЕ СОСТОЯНИЕ D3 ОТКЛЮЧЕНО
echo ================================================================================

echo.