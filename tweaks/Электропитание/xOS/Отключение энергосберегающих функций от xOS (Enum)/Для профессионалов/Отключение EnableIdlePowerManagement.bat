@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ
echo                    УПРАВЛЕНИЯ ПИТАНИЕМ В ПРОСТОЕ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo EnableIdlePowerManagement - управление питанием устройства в режиме простоя.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Устройства всегда на максимальной производительности
echo [+] Нет задержек при начале работы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Увеличивает энергопотребление в простое
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f "delims=" %%b in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum" /s ^| findstr /i "EnableIdlePowerManagement"') do (
    echo %%b | findstr /i "HKEY" >nul
    if not errorlevel 1 (
        Reg.exe add "%%b" /v "EnableIdlePowerManagement" /t REG_DWORD /d "0" /f >nul 2>&1
    )
)

echo.
echo ================================================================================
echo               ГОТОВО! УПРАВЛЕНИЕ ПИТАНИЕМ В ПРОСТОЕ ОТКЛЮЧЕНО
echo ================================================================================

echo.