@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ POWER THROTTLING
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Power Throttling - это технология Windows, которая снижает частоту процессора
echo для фоновых задач, чтобы экономить энергию.
echo.
echo При отключении:
echo   - Все процессы (включая фоновые) работают на максимальной частоте
echo   - Процессор всегда находится в активном состоянии
echo   - Убираются "просадки" производительности в фоне
echo.
echo Команда: Reg.exe add "...\PowerThrottling" /v "PowerThrottlingOff" /t REG_DWORD /d "1"
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] МАКСИМАЛЬНАЯ ПРОИЗВОДИТЕЛЬНОСТЬ для всех процессов
echo [+] Убирает задержки при переключении между задачами
echo [+] Фоновые задачи (загрузка, обновления) не тормозят систему
echo [+] Полезно для профессиональных приложений и игр
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Повышенное энергопотребление (процессор не "спит" в фоне)
echo [-] На ноутбуках батарея садится значительно быстрее
echo [-] Увеличивается нагрев процессора в простое
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ДЕСКТОПЫ - ОТКЛЮЧАЙТЕ СМЕЛО (максимальная производительность)
echo [2] НОУТБУКИ - отключайте только при игре от сети
echo [3] После игр на ноутбуке лучше вернуть обратно (для экономии батареи)
echo [4] Для возврата используйте "Включение Power Throttling.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Отключаю Power Throttling...
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling" /v "PowerThrottlingOff" /t REG_DWORD /d "1" /f

echo.
echo ================================================================================
echo                    ГОТОВО! POWER THROTTLING ОТКЛЮЧЕН
echo ================================================================================
echo.
echo Теперь все процессы работают на максимальной частоте процессора.
echo Для возврата используйте "Включение Power Throttling.bat"

echo.