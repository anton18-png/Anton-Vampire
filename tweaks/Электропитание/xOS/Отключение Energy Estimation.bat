@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ ENERGY ESTIMATION
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт включает обратно функцию Energy Estimation.
echo.
echo Эта функция оценивает энергопотребление системы и отображает его
echo в диспетчере задач и других системных утилитах.
echo.
echo Команда: Reg.exe add "HKLM\...\Power" /v "EnergyEstimationEnabled" /t REG_DWORD /d "1"
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Возвращает отображение энергопотребления в диспетчере задач
echo [+] Позволяет отслеживать энергоэффективность приложений
echo [+] Восстанавливает стандартное поведение системы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Небольшая дополнительная нагрузка на процессор
echo [-] Больше фоновых операций записи в логи
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Включайте, если хотите видеть энергопотребление в диспетчере задач
echo [2] Это настройка по умолчанию в Windows
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Включаю Energy Estimation...
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power" /v "EnergyEstimationEnabled" /t REG_DWORD /d "1" /f >nul 2>&1

echo.
echo ================================================================================
echo                    ГОТОВО! ENERGY ESTIMATION ВКЛЮЧЕНА
echo ================================================================================
echo.
echo Теперь диспетчер задач снова показывает энергопотребление процессов.

echo.