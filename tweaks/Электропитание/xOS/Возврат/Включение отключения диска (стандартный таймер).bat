@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ ОТКЛЮЧЕНИЯ ДИСКА
echo                    (СТАНДАРТНЫЙ ТАЙМЕР 20 МИНУТ)
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт ВОССТАНАВЛИВАЕТ стандартное автоматическое отключение жесткого диска.
echo.
echo Что происходит:
echo   - Диск отключается через 20 минут бездействия
echo   - Значение таймера отключения устанавливается в 20 минут (1200 секунд)
echo   - Применяется как для работы от сети (AC), так и от батареи (DC)
echo.
echo Это стандартные настройки Windows по умолчанию.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Экономит электроэнергию (диск отключается в простое)
echo [+] На ноутбуках увеличивает время автономной работы
echo [+] Уменьшает шум от HDD (диск не вращается постоянно)
echo [+] Снижает нагрев и износ жесткого диска
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Возможны задержки при обращении к диску после простоя
echo [-] Программам может потребоваться время на "пробуждение" диска
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запускайте если хотите вернуть стандартное энергосбережение
echo [2] Рекомендуется для ноутбуков (экономит батарею)
echo [3] Рекомендуется для HDD (меньше шума и износа)
echo [4] Для SSD можно оставить отключенным (убирает задержки)
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Восстанавливаю стандартный таймер отключения диска: 20 минут (1200 секунд)...
powercfg /SETACVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 1200
powercfg /SETDCVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 1200
powercfg /SETACTIVE SCHEME_CURRENT

echo.
echo ================================================================================
echo               ГОТОВО! ДИСК БУДЕТ ОТКЛЮЧАТЬСЯ ЧЕРЕЗ 20 МИНУТ
echo ================================================================================
echo.
echo Настройка применена к текущей схеме питания.
echo Диск теперь будет отключаться через 20 минут бездействия.
echo Для повторного отключения таймера используйте скрипт "Отключение диска (НИКОГДА).bat"
echo.

echo.