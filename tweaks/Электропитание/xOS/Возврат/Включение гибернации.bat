@echo off
chcp 65001 >nul

echo ================================================================================
echo                         		ВКЛЮЧЕНИЕ ГИБЕРНАЦИИ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт включает гибернацию в Windows.
echo.
echo Что происходит:
echo   - Создает файл hiberfil.sys размером примерно 40-75% от объема ОЗУ
echo   - Включает режим "Гибернация" в меню Пуск
echo   - Включает "Быстрый запуск" (Fast Startup)
echo.
echo Команда: powercfg -h on
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Быстрый запуск Windows работает (загрузка на 2-5 секунд быстрее)
echo [+] Режим гибернации доступен (сохраняет все открытые программы при выключении)
echo [+] На ноутбуках батарея не разряжается при закрытой крышке
echo [+] Система может сохранять дамп памяти при синих экранах
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Файл hiberfil.sys занимает место на диске (обычно 10-40 ГБ)
echo [-] Увеличивается износ SSD диска (частая запись больших объемов)
echo [-] При каждом выключении Windows пишет дамп памяти
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Включайте только если вам критичен быстрый запуск или режим гибернации
echo [2] На десктопах с SSD лучше держать гибернацию выключенной
echo [3] На ноутбуках с малым SSD - альтернатива: просто использовать сон (Sleep)
echo [4] Если места на диске мало - не включайте гибернацию
echo [5] Для отключения гибернации запустите скрипт "Отключение гибернации.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Выполняю команду: powercfg -h on
powercfg -h on

echo.
echo ================================================================================
echo                         ГОТОВО! ГИБЕРНАЦИЯ ВКЛЮЧЕНА
echo ================================================================================
echo.
echo Файл hiberfil.sys создан, место на диске занято.
echo Для применения изменений перезагрузите компьютер.
echo Для отключения гибернации используйте скрипт "Отключение гибернации.bat"

echo.