@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ВКЛЮЧЕНИЕ POWER THROTTLING
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт включает обратно технологию Power Throttling.
echo.
echo Power Throttling снижает частоту процессора для фоновых задач,
echo что позволяет экономить энергию без ущерба для активных программ.
echo.
echo Команда: Reg.exe add "...\PowerThrottling" /v "PowerThrottlingOff" /t REG_DWORD /d "0"
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Экономит энергию на ноутбуках
echo [+] Снижает нагрев процессора в фоновых задачах
echo [+] Увеличивает время автономной работы
echo [+] Это стандартное поведение Windows
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Фоновые задачи работают медленнее
echo [-] Возможны микро-задержки при переключении между задачами
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] На ноутбуках - рекомендуется оставлять включенным
echo [2] На десктопах - можно отключить для максимальной производительности
echo [3] Это настройка по умолчанию в Windows
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Включаю Power Throttling...
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling" /v "PowerThrottlingOff" /t REG_DWORD /d "0" /f

echo.
echo ================================================================================
echo                    ГОТОВО! POWER THROTTLING ВКЛЮЧЕН
echo ================================================================================
echo.
echo Теперь фоновые задачи будут работать в энергосберегающем режиме.
echo Для отключения используйте "Отключение Power Throttling.bat"

echo.