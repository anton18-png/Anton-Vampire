@echo off
chcp 65001 >nul

echo ================================================================================
echo                    xOS PLAYBOOK - ОТКЛЮЧЕНИЕ ДИСКА (НИКОГДА)
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт отключает автоматическое отключение жесткого диска.
echo.
echo Что происходит:
echo   - Диск НИКОГДА не отключается через питание
echo   - Значение таймера отключения устанавливается в 0
echo   - Применяется как для работы от сети (AC), так и от батареи (DC)
echo.
echo Команды:
echo   powercfg /SETACVALUEINDEX SCHEME_CURRENT ... 0
echo   powercfg /SETDCVALUEINDEX SCHEME_CURRENT ... 0
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Полезно для SSD (меньше циклов парковки головок, хотя у SSD их нет)
echo [+] Устраняет задержки при обращении к диску после простоя
echo [+] Особенно актуально для HDD с агрессивным энергосбережением
echo [+] Программы не ждут "пробуждения" диска
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Диск никогда не отключается - повышенное энергопотребление
echo [-] На ноутбуках снижается время автономной работы
echo [-] HDD будет постоянно вращаться (шум и износ)
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Для SSD - МОЖНО отключать (это не вредит и убирает задержки)
echo [2] Для HDD на десктопе - отключайте, если шум не мешает
echo [3] Для HDD на ноутбуке - НЕ отключайте (батарея будет садиться быстрее)
echo [4] Для возврата стандартного таймера (20 минут) - используйте скрипт отката
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Устанавливаю отключение диска: НИКОГДА (значение 0)...
powercfg /SETACVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0
powercfg /SETDCVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0
powercfg /SETACTIVE SCHEME_CURRENT

echo.
echo ================================================================================
echo                    ГОТОВО! ДИСК НИКОГДА НЕ ОТКЛЮЧАЕТСЯ
echo ================================================================================
echo.
echo Настройка применена к текущей схеме питания.
echo Для возврата к стандартным настройкам используйте скрипт отката.

echo.