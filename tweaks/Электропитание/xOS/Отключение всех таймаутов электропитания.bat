@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - НАСТРОЙКА ЭЛЕКТРОПИТАНИЯ
echo               (ОТКЛЮЧЕНИЕ ВСЕХ ТАЙМАУТОВ ЭНЕРГОСБЕРЕЖЕНИЯ)
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Windows имеет встроенные механизмы энергосбережения, которые:
echo.
echo   - ОТКЛЮЧАЮТ ЭКРАН через N минут бездействия
echo   - ОТКЛЮЧАЮТ ДИСКИ через N минут бездействия
echo   - ПЕРЕВОДЯТ КОМПЬЮТЕР В СОН через N минут
echo   - ВКЛЮЧАЮТ ГИБЕРНАЦИЮ через N минут
echo.
echo Эти механизмы полезны для ноутбуков (экономия батареи),
echo но на десктопах и игровых ПК они часто мешают:
echo.
echo   - Экран тухнет во время просмотра длинных видео
echo   - Диск отключается и потом долго "просыпается"
echo   - Компьютер уходит в сон во время загрузки/рендера
echo.
echo Данный скрипт ОТКЛЮЧАЕТ ВСЕ ТАЙМАУТЫ ЭНЕРГОСБЕРЕЖЕНИЯ:
echo.
echo   - Монитор НИКОГДА не отключается (0 минут)
echo   - Диски НИКОГДА не отключаются (0 минут)
echo   - Компьютер НИКОГДА не уходит в сон (0 минут)
echo   - Гибернация НИКОГДА не включается автоматически (0 минут)
echo.
echo Команды применяются как для работы от сети (AC), так и от батареи (DC).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ЭКРАН НЕ ГАСНЕТ во время просмотра видео или чтения
echo [+] ДИСКИ НЕ ОТКЛЮЧАЮТСЯ (нет задержек при доступе к файлам)
echo [+] КОМПЬЮТЕР НЕ УХОДИТ В СОН во время длительных задач
echo [+] Полезно для десктопов при скачивании больших файлов
echo [+] Полезно для рендеринга видео, компиляции кода
echo [+] Полезно для серверов и круглосуточной работы
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] ЭЛЕКТРОЭНЕРГИЯ расходуется постоянно (экран всегда включен)
echo [-] ДИСКИ ПОСТОЯННО ВРАЩАЮТСЯ (шуметь, если HDD)
echo [-] На НОУТБУКАХ батарея садится очень быстро
echo [-] КОМПЬЮТЕР НЕ ЗАСЫПАЕТ (не экономит энергию)
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ДЕСКТОПЫ / ИГРОВЫЕ ПК - ОДНОЗНАЧНО РЕКОМЕНДУЕТСЯ
echo [2] НОУТБУКИ ОТ СЕТИ - рекомендуется (при работе за столом)
echo [3] НОУТБУКИ ОТ БАТАРЕИ - НЕ РЕКОМЕНДУЕТСЯ (батарея сядет за 1-2 часа)
echo [4] Если хотите вернуть стандартные таймауты - используйте скрипт отката
echo [5] Стандартные значения Windows: монитор 10 мин, диск 20 мин, сон 30 мин
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo [1/8] Отключение таймаута отключения монитора (питание от сети)...
powercfg /x monitor-timeout-ac 0
echo [OK] Монитор НИКОГДА не отключается от сети
echo.

echo [2/8] Отключение таймаута отключения монитора (питание от батареи)...
powercfg /x monitor-timeout-dc 0
echo [OK] Монитор НИКОГДА не отключается от батареи
echo.

echo [3/8] Отключение таймаута отключения дисков (питание от сети)...
powercfg /x disk-timeout-ac 0
echo [OK] Диски НИКОГДА не отключаются от сети
echo.

echo [4/8] Отключение таймаута отключения дисков (питание от батареи)...
powercfg /x disk-timeout-dc 0
echo [OK] Диски НИКОГДА не отключаются от батареи
echo.

echo [5/8] Отключение таймаута перехода в сон (питание от сети)...
powercfg /x standby-timeout-ac 0
echo [OK] Компьютер НИКОГДА не уходит в сон от сети
echo.

echo [6/8] Отключение таймаута перехода в сон (питание от батареи)...
powercfg /x standby-timeout-dc 0
echo [OK] Компьютер НИКОГДА не уходит в сон от батареи
echo.

echo [7/8] Отключение таймаута гибернации (питание от сети)...
powercfg /x hibernate-timeout-ac 0
echo [OK] Гибернация НИКОГДА не включается автоматически от сети
echo.

echo [8/8] Отключение таймаута гибернации (питание от батареи)...
powercfg /x hibernate-timeout-dc 0
echo [OK] Гибернация НИКОГДА не включается автоматически от батареи
echo.

echo ================================================================================
echo                         ГОТОВО! НАСТРОЙКИ ПРИМЕНЕНЫ
echo ================================================================================
echo.
echo Что сделано:
echo   - Монитор никогда не отключается (AC и DC)
echo   - Диски никогда не отключаются (AC и DC)
echo   - Компьютер никогда не уходит в сон (AC и DC)
echo   - Гибернация никогда не включается автоматически (AC и DC)
echo.
echo ТЕПЕРЬ ЭКРАН НЕ ПОТУХНЕТ, ДИСКИ НЕ ЗАСНУТ, ПК НЕ УЙДЕТ В СОН.
echo.
echo ДЛЯ ВОЗВРАТА СТАНДАРТНЫХ НАСТРОЕК:
echo   powercfg /x monitor-timeout-ac 10
echo   powercfg /x monitor-timeout-dc 5
echo   powercfg /x disk-timeout-ac 20
echo   powercfg /x disk-timeout-dc 10
echo   powercfg /x standby-timeout-ac 30
echo   powercfg /x standby-timeout-dc 15
echo.