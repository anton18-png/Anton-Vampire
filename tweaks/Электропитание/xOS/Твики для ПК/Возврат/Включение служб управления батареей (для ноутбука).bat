@echo off
chcp 65001 >nul

echo ================================================================================
echo              xOS PLAYBOOK - ВКЛЮЧЕНИЕ СЛУЖБ УПРАВЛЕНИЯ БАТАРЕЕЙ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт включает обратно службы управления батареей.
echo.
echo Включаются следующие службы (Start = 3 - Manual):
echo   - Cmbatt   (драйвер батареи Microsoft)
echo   - acpiex   (расширенный ACPI драйвер)
echo   - acpipagr (ACPI агрегатор)
echo   - acpipmi  (ACPI PMI интерфейс)
echo   - acpitime (ACPI таймер)
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Восстанавливает стандартное поведение системы
echo [+] Возвращает работу с батареей на ноутбуках
echo [+] Решает проблемы с питанием после их отключения
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Нет минусов - это возврат к настройкам по умолчанию
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запустите этот скрипт, если у вас ноутбук или возникли проблемы
echo [2] После включения рекомендуется перезагрузиться
echo [3] Это стандартные настройки Windows по умолчанию
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Включаю службы управления батареей...
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Cmbatt" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpiex" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpipagr" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpipmi" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpitime" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1

echo.
echo ================================================================================
echo               ГОТОВО! СЛУЖБЫ УПРАВЛЕНИЯ БАТАРЕЕЙ ВКЛЮЧЕНЫ
echo ================================================================================
echo.
echo Настройки возвращены к стандартным (Start = 3 - Manual).
echo Рекомендуется перезагрузить компьютер.

echo.