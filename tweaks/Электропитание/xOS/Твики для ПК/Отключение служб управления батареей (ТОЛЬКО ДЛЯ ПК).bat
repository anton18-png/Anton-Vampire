@echo off
chcp 65001 >nul

echo ================================================================================
echo              xOS PLAYBOOK - ОТКЛЮЧЕНИЕ СЛУЖБ УПРАВЛЕНИЯ БАТАРЕЕЙ
echo                       (ТОЛЬКО ДЛЯ ДЕСКТОПОВ!)
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт отключает службы управления батареей и электропитанием.
echo.
echo Отключаются следующие службы:
echo   - Cmbatt   (драйвер батареи Microsoft)
echo   - acpiex   (расширенный ACPI драйвер)
echo   - acpipagr (ACPI агрегатор)
echo   - acpipmi  (ACPI PMI интерфейс)
echo   - acpitime (ACPI таймер)
echo.
echo Каждая служба устанавливается в режим "Отключена" (Start = 4)
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Убирает лишние драйверы из памяти на десктопе
echo [+] Снижает количество фоновых процессов
echo [+] Ускоряет загрузку системы (меньше служб для запуска)
echo [+] Ненужно на ПК без батареи
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] НА НОУТБУКЕ ЭТИ СЛУЖБЫ ОТКЛЮЧАТЬ НЕЛЬЗЯ (Windows не загрузится!)
echo [-] На некоторых десктопах может повлиять на определение кнопки питания
echo [-] Отключение может помешать работе режимов сна
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ЗАПУСКАТЬ ТОЛЬКО НА СТАЦИОНАРНЫХ ДЕСКТОПАХ!
echo [2] На ноутбуках, моноблоках со встроенным ИБП - НЕ ЗАПУСКАТЬ!
echo [3] Если не уверены в типе устройства - не запускайте
echo [4] Для восстановления служб используйте скрипт отката
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Отключаю службы управления батареей...
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Cmbatt" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpiex" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpipagr" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpipmi" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1
Reg.exe add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\acpitime" /v "Start" /t REG_DWORD /d "4" /f >nul 2>&1

echo.
echo ================================================================================
echo               ГОТОВО! СЛУЖБЫ УПРАВЛЕНИЯ БАТАРЕЕЙ ОТКЛЮЧЕНЫ
echo ================================================================================
echo.
echo ВНИМАНИЕ!!!
echo Этот скрипт только для ДЕСКТОПОВ!!!
echo Если вы на ноутбуке - немедленно запустите скрипт отката!!!
echo Для восстановления служб используйте "Включение служб управления батареей.bat"

echo.