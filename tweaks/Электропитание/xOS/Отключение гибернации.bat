@echo off
chcp 65001 >nul

echo ================================================================================
echo                         		ОТКЛЮЧЕНИЕ ГИБЕРНАЦИИ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт отключает гибернацию в Windows.
echo.
echo Что происходит:
echo   - Удаляет файл hiberfil.sys, который занимает место размером с ОЗУ
echo   - Например, при 32 ГБ ОЗУ освобождается 32 ГБ на диске
echo   - Отключает режим "Гибернация" в меню Пуск
echo   - Отключает "Быстрый запуск" (Fast Startup)
echo.
echo Команда: powercfg -h off
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ОСВОБОЖДАЕТ МЕСТО НА ДИСКЕ - часто 10-40 ГБ (зависит от объема ОЗУ)
echo [+] Уменьшает износ SSD диска (меньше операций записи)
echo [+] Ускоряет некоторые операции записи/чтения на системном диске
echo [+] Система не пишет дамп памяти при каждом выключении
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Быстрый запуск Windows перестает работать (загрузка становится медленнее)
echo [-] Режим гибернации недоступен (нельзя сохранить открытые программы при выключении)
echo [-] На ноутбуках может уйти в глубокий разряд батареи при закрытии крышки
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] На десктопах с SSD - ОТКЛЮЧАЙТЕ (место важнее 2-3 секунд загрузки)
echo [2] На десктопах с HDD - НЕ ОТКЛЮЧАЙТЕ (загрузка будет очень долгой)
echo [3] На ноутбуках - подумайте, нужен ли вам быстрый запуск от батареи
echo [4] Если используете обычный сон (Sleep) - гибернация вам не нужна
echo [5] Для возврата гибернации запустите скрипт "Включение гибернации.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo Выполняю команду: powercfg -h off
powercfg -h off

echo.
echo ================================================================================
echo                         ГОТОВО! ГИБЕРНАЦИЯ ОТКЛЮЧЕНА
echo ================================================================================
echo.
echo Файл hiberfil.sys удален, место на диске освобождено.
echo Для применения изменений перезагрузите компьютер.
echo Для возврата гибернации используйте скрипт "Включение гибернации.bat"

echo.