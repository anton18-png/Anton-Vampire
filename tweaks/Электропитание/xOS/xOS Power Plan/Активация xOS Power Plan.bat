@echo off
chcp 65001 >nul

echo ================================================================================
echo                         xOS PLAYBOOK - АКТИВАЦИЯ XOS POWER PLAN
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт активирует схему питания XOS Power Plan.
echo.
echo Схема активируется по GUID: 31693169-3169-3169-3169-316931693169
echo.
echo Команда: powercfg -SETACTIVE "31693169-3169-3169-3169-316931693169"
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Мгновенное применение схемы без перезагрузки
echo [+] XOS Power Plan обеспечивает максимальную производительность
echo [+] План оптимизирован для игр и тяжелых задач
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Если схема не импортирована - активация не сработает
echo [-] Повышенное энергопотребление по сравнению со стандартными планами
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Сначала запустите "Импорт XOS Power Plan.bat"
echo [2] Активация применяется мгновенно, перезагрузка не требуется
echo [3] Чтобы вернуть стандартную схему, выберите "Сбалансированная" в панели питания
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

set POWER_PLAN_PATH="C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\XOS Power Plan.pow"

if exist %POWER_PLAN_PATH% (
    echo Файл XOS Power Plan.pow найден, выполняю импорт...
    powercfg -import %POWER_PLAN_PATH% 31693169-3169-3169-3169-316931693169 >nul 2>&1
    echo [OK] Импорт выполнен
) else (
    echo [ОШИБКА] Файл XOS Power Plan.pow НЕ НАЙДЕН!
    echo Проверьте путь: C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\
    echo Импорт невозможен. Скачайте файл схемы питания xOS.
)

echo Активирую XOS Power Plan...
powercfg -SETACTIVE "31693169-3169-3169-3169-316931693169" >nul 2>&1

echo.
echo ================================================================================
echo                         ГОТОВО! XOS POWER PLAN АКТИВИРОВАН
echo ================================================================================
echo.
echo Теперь система работает по схеме XOS Power Plan.
echo Для возврата к стандартной схеме выберите "Сбалансированная" в панели управления.

echo.