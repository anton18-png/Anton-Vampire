@echo off
chcp 65001 >nul

echo ================================================================================
echo                         xOS PLAYBOOK - ИМПОРТ XOS POWER PLAN
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт импортирует схему питания XOS Power Plan из файла:
echo.
echo   C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\XOS Power Plan.pow
echo.
echo Схема импортируется с GUID: 31693169-3169-3169-3169-316931693169
echo.
echo Команда: powercfg -import "путь_к_файлу" 31693169-3169-3169-3169-316931693169
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] XOS Power Plan - кастомный план с максимальной производительностью
echo [+] После импорта схему можно выбрать в панели управления питанием
echo [+] Импорт не меняет активную схему, только добавляет новую
echo [+] Файл схемы хранится в папке xOS Playbook, не засоряет Windows
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Если файл XOS Power Plan.pow отсутствует - импорт не произойдет
echo [-] Схема может не работать на некоторых конфигурациях ПК
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Убедитесь, что файл XOS Power Plan.pow существует в указанной папке
echo [2] Если файла нет - скачайте его из репозитория xOS Playbook
echo [3] После импорта запустите "Активация XOS Power Plan.bat" для применения
echo [4] Путь к схеме: C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

set POWER_PLAN_PATH="C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\XOS Power Plan.pow"

if exist %POWER_PLAN_PATH% (
    echo Файл XOS Power Plan.pow найден, выполняю импорт...
    powercfg -import %POWER_PLAN_PATH% 31693169-3169-3169-3169-316931693169 >nul 2>&1
    echo [OK] Импорт выполнен
) else (
    echo [ОШИБКА] Файл XOS Power Plan.pow НЕ НАЙДЕН!
    echo Проверьте путь: C:\Apps\Extreme\tweaks\Электропитание\Все планы электропитания\
    echo Импорт невозможен. Скачайте файл схемы питания xOS.
)

echo.
echo ================================================================================
echo                         ГОТОВО! XOS POWER PLAN ИМПОРТИРОВАН
echo ================================================================================
echo.
echo Схема добавлена в систему. Для активации запустите "Активация XOS Power Plan.bat"

echo.