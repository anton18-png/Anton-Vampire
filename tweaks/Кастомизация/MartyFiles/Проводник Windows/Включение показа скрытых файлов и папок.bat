@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ВКЛЮЧЕНИЕ ПОКАЗА СКРЫТЫХ ФАЙЛОВ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Windows по умолчанию скрывает системные файлы и папки, а также файлы,
echo помеченные как "скрытые". Это сделано для защиты от случайного удаления.
echo.
echo Данный скрипт ВКЛЮЧАЕТ ПОКАЗ ВСЕХ СКРЫТЫХ ФАЙЛОВ И ПАПОК.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ВИДНЫ ВСЕ ФАЙЛЫ И ПАПКИ (включая AppData, ProgramData)
echo [+] УДОБНО ДЛЯ ПРОДВИНУТЫХ ПОЛЬЗОВАТЕЛЕЙ
echo [+] НЕ НУЖНО ВКЛЮЧАТЬ ПОКАЗ СКРЫТЫХ ФАЙЛОВ ВРУЧНУЮ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Риск случайно удалить или изменить системные файлы
echo [-] Проводник выглядит более загроможденным
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для продвинутых пользователей и админов
echo [2] НЕ РЕКОМЕНДУЕТСЯ для обычных пользователей
echo [3] Будьте осторожны при удалении файлов
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "Hidden" /t REG_DWORD /d 1 /f

echo.
echo ================================================================================
echo              ГОТОВО! ПОКАЗ СКРЫТЫХ ФАЙЛОВ И ПАПОК ВКЛЮЧЕН
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Отключение показа скрытых файлов и папок.bat"
echo.

echo.