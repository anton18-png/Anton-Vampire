@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ РЕКОМЕНДАЦИЙ В МЕНЮ ПУСК
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo В меню Пуск Windows показывает "рекомендации" - недавно установленные
echo приложения, популярные приложения и рекламу из Microsoft Store.
echo.
echo Данный скрипт ОТКЛЮЧАЕТ ЭТИ РЕКОМЕНДАЦИИ.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] МЕНЮ ПУСК СТАНОВИТСЯ ЧИЩЕ
echo [+] НЕТ РЕКЛАМЫ ОТ MICROSOFT
echo [+] НЕТ НАВЯЗЧИВЫХ РЕКОМЕНДАЦИЙ
echo [+] ПОВЫШЕНИЕ КОНФИДЕНЦИАЛЬНОСТИ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Не видны рекомендации по установленным приложениям
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] РЕКОМЕНДУЕТСЯ ВСЕМ, кто хочет чистое меню Пуск
echo [2] Убирает назойливую рекламу
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer" /v "ShowRecommendations" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo               ГОТОВО! РЕКОМЕНДАЦИИ В МЕНЮ ПУСК ОТКЛЮЧЕНЫ
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение рекомендаций в меню Пуск.bat"
echo.

echo.