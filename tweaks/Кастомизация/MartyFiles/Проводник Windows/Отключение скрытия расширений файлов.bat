@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ СКРЫТИЯ РАСШИРЕНИЙ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Windows по умолчанию скрывает расширения файлов (например, .txt, .exe, .jpg),
echo показывая только имя файла. Это сделано для простоты, но опасно, так как
echo вирусы могут маскироваться под другие файлы (virus.jpg.exe).
echo.
echo Данный скрипт ОТКЛЮЧАЕТ СКРЫТИЕ РАСШИРЕНИЙ ФАЙЛОВ.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ВИДНЫ ВСЕ РАСШИРЕНИЯ ФАЙЛОВ (.exe, .txt, .jpg, .dll)
echo [+] БЕЗОПАСНЕЕ (видно, что файл на самом деле .exe, а не .jpg)
echo [+] УДОБНО ДЛЯ ПРОДВИНУТЫХ ПОЛЬЗОВАТЕЛЕЙ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Имена файлов выглядят длиннее (файл.txt вместо файл)
echo [-] Может сбивать с толку обычных пользователей
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ПОВЫШЕНИЯ БЕЗОПАСНОСТИ
echo [2] Рекомендуется для всех продвинутых пользователей
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "HideFileExt" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo                ГОТОВО! РАСШИРЕНИЯ ФАЙЛОВ ВИДНЫ
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение скрытия расширений файлов.bat"
echo.

echo.