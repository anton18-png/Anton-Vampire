@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ ТЕНЕЙ ПОД ЗНАЧКАМИ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Тени под значками - это визуальный эффект, который создает объемность
echo значков на рабочем столе и в Проводнике Windows.
echo.
echo Данный скрипт ОТКЛЮЧАЕТ ТЕНИ ПОД ЗНАЧКАМИ.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ НАГРУЗКУ НА GPU
echo [+] УСКОРЯЕТ ОТРИСОВКУ РАБОЧЕГО СТОЛА
echo [+] УЛУЧШАЕТ ОТЗЫВЧИВОСТЬ ПРОВОДНИКА
echo [+] ПОЛЕЗНО ДЛЯ СЛАБЫХ И СРЕДНИХ ПК
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Значки выглядят плоскими, без объема
echo [-] Пропадает визуальная глубина
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "ListviewShadow" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo                    ГОТОВО! ТЕНИ ПОД ЗНАЧКАМИ ОТКЛЮЧЕНЫ
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение теней под значками.bat"
echo.

echo.