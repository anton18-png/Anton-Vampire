@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ВКЛЮЧЕНИЕ ТЕМНОЙ ТЕМЫ ДЛЯ ПРИЛОЖЕНИЙ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт ВКЛЮЧАЕТ ТЕМНУЮ ТЕМУ ДЛЯ ПРИЛОЖЕНИЙ:
echo   - Microsoft Store приложения
echo   - Современные UWP приложения
echo   - Некоторые классические приложения с поддержкой тем
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ЕДИНЫЙ СТИЛЬ ОФОРМЛЕНИЯ для всех приложений
echo [+] МЕНЬШЕ НАГРУЗКИ НА ГЛАЗА
echo [+] СОВРЕМЕННЫЙ ВИД
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Не все приложения поддерживают темную тему
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Включайте вместе с темной темой для системы
echo [2] Для единого стиля оформления
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v "AppsUseLightTheme" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo              ГОТОВО! ТЕМНАЯ ТЕМА ДЛЯ ПРИЛОЖЕНИЙ ВКЛЮЧЕНА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение светлой темы для приложений.bat"
echo.

echo.