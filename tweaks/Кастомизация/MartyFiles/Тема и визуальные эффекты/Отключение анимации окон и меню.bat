@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ АНИМАЦИИ ОКОН И МЕНЮ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo VisualFXSetting управляет всеми визуальными эффектами Windows.
echo Значение 3 = Настройка для максимальной производительности.
echo
echo Данный скрипт ОТКЛЮЧАЕТ ВСЕ АНИМАЦИИ ОКОН И МЕНЮ:
echo   - Анимация сворачивания/разворачивания окон
echo   - Анимация появления меню
echo   - Анимация затухания
echo   - Плавная прокрутка
echo   - И другие эффекты
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] МАКСИМАЛЬНОЕ УСКОРЕНИЕ ИНТЕРФЕЙСА
echo [+] СНИЖЕНИЕ НАГРУЗКИ НА CPU И GPU
echo [+] ПОВЫШЕНИЕ ПРОИЗВОДИТЕЛЬНОСТИ В ИГРАХ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Интерфейс становится "дерганным", без анимаций
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v "VisualFXSetting" /t REG_DWORD /d 3 /f

echo.
echo ================================================================================
echo                ГОТОВО! АНИМАЦИИ ОКОН И МЕНЮ ОТКЛЮЧЕНЫ
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение анимации окон и меню.bat"
echo.

echo.