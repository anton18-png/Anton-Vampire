@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ AERO PEEK
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Aero Peek - это функция Windows, которая позволяет:
echo   - При наведении на правый угол панели задач показывает рабочий стол
echo   - Показывает превью окон при наведении на значки на панели задач
echo.
echo Данный скрипт ОТКЛЮЧАЕТ AERO PEEK.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ НАГРУЗКУ НА GPU
echo [+] УСКОРЯЕТ РАБОТУ ПАНЕЛИ ЗАДАЧ
echo [+] ПРЕДОТВРАЩАЕТ СЛУЧАЙНЫЕ СРАБАТЫВАНИЯ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Не видно превью окон на панели задач
echo [-] Не работает быстрый просмотр рабочего стола
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для геймеров
echo [2] Убирает отвлекающий эффект при наведении
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\DWM" /v "EnableAeroPeek" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo                      ГОТОВО! AERO PEEK ОТКЛЮЧЕН
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение Aero Peek.bat"
echo.

echo.