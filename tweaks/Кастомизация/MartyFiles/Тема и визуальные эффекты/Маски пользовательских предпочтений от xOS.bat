@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - НАСТРОЙКА МАСКИ ПОЛЬЗОВАТЕЛЬСКИХ ПРЕДПОЧТЕНИЙ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo UserPreferencesMask - это двоичный параметр, который хранит настройки
echo визуальных эффектов Windows: анимации окон, сглаживание шрифтов,
echo отображение теней и многое другое.
echo.
echo Данный скрипт УСТАНАВЛИВАЕТ ОПТИМИЗИРОВАННУЮ МАСКУ (9012038012000000),
echo которая отключает большинство визуальных эффектов.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ОТКЛЮЧАЕТ МНОЖЕСТВО ВИЗУАЛЬНЫХ ЭФФЕКТОВ одной настройкой
echo [+] СНИЖАЕТ НАГРУЗКУ НА СИСТЕМУ
echo [+] ПОВЫШАЕТ ПРОИЗВОДИТЕЛЬНОСТЬ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Интерфейс становится менее "красивым"
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\Control Panel\Desktop" /v "UserPreferencesMask" /t REG_BINARY /d "9012038012000000" /f

echo.
echo ================================================================================
echo               ГОТОВО! МАСКА ПОЛЬЗОВАТЕЛЬСКИХ ПРЕДПОЧТЕНИЙ НАСТРОЕНА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Восстановление стандартной маски предпочтений.bat"
echo.

echo.