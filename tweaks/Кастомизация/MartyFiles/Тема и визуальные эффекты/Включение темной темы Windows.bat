@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ВКЛЮЧЕНИЕ ТЕМНОЙ ТЕМЫ WINDOWS
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Windows имеет два режима оформления: светлая тема (по умолчанию) и темная тема.
echo.
echo Данный скрипт ВКЛЮЧАЕТ ТЕМНУЮ ТЕМУ ДЛЯ СИСТЕМЫ:
echo   - Панель задач становится темной
echo   - Меню Пуск становится темным
echo   - Проводник становится темным
echo   - Системные окна становятся темными
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] МЕНЬШЕ НАГРУЗКИ НА ГЛАЗА (особенно в темное время суток)
echo [+] ЭКОНОМИТ ЭНЕРГИЮ НА OLED-ЭКРАНАХ
echo [+] СОВРЕМЕННЫЙ И СТИЛЬНЫЙ ВИД
echo [+] МЕНЬШЕ ОТВЛЕЧАЕТ ПРИ РАБОТЕ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Не всем нравится темная тема
echo [-] Некоторые приложения могут отображаться некорректно
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для работы в темное время суток
echo [2] Рекомендуется для OLED-экранов (экономия энергии)
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v "SystemUsesLightTheme" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo              ГОТОВО! ТЕМНАЯ ТЕМА ДЛЯ СИСТЕМЫ ВКЛЮЧЕНА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение светлой темы Windows.bat"
echo.

echo.