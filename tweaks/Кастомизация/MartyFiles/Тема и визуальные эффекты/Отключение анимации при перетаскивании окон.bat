@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ АНИМАЦИИ ПРИ ПЕРЕТАСКИВАНИИ ОКОН
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo При перетаскивании окон Windows показывает содержимое окна (DragFullWindows).
echo Этот эффект потребляет ресурсы графической подсистемы.
echo.
echo Данный скрипт ОТКЛЮЧАЕТ ОТОБРАЖЕНИЕ СОДЕРЖИМОГО ПРИ ПЕРЕТАСКИВАНИИ ОКОН
echo (показывает только контур окна).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ НАГРУЗКУ НА GPU И CPU
echo [+] УСКОРЯЕТ ПЕРЕТАСКИВАНИЕ ОКОН
echo [+] ПОЛЕЗНО ДЛЯ СЛАБЫХ И СРЕДНИХ ПК
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] При перетаскивании виден только контур окна (не содержимое)
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\Control Panel\Desktop" /v "DragFullWindows" /t REG_SZ /d "0" /f

echo.
echo ================================================================================
echo            ГОТОВО! АНИМАЦИЯ ПРИ ПЕРЕТАСКИВАНИИ ОКОН ОТКЛЮЧЕНА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение анимации при перетаскивании окон.bat"
echo.

echo.