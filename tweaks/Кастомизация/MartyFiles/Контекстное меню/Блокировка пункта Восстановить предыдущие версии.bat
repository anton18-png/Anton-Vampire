@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - БЛОКИРОВКА ПУНКТА КОНТЕКСТНОГО МЕНЮ
echo                    "ВОССТАНОВИТЬ ПРЕДЫДУЩИЕ ВЕРСИИ"
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт УДАЛЯЕТ из контекстного меню Windows пункт:
echo.
echo   - "Восстановить предыдущие версии"
echo.
echo Этот пункт появляется при ПКМ на файлах и папках и связан с:
echo   - Теневыми копиями (Volume Shadow Copy)
echo   - Историей файлов (File History)
echo   - Точками восстановления системы
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] УБИРАЕТ РЕДКО ИСПОЛЬЗУЕМЫЙ ПУНКТ из контекстного меню
echo [+] КОНТЕКСТНОЕ МЕНЮ СТАНОВИТСЯ КОРОЧЕ
echo [+] УМЕНЬШАЕТ ВРЕМЯ ОТКРЫТИЯ КОНТЕКСТНОГО МЕНЮ
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Если нужно восстановить предыдущую версию файла - пункта не будет
echo [-] Придется искать файл через свойства или панель управления
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Если не пользуетесь восстановлением предыдущих версий - ОТКЛЮЧАЙТЕ
echo [2] Для возврата используйте скрипт "Восстановление пункта Восстановить предыдущие версии.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo [1/2] Блокировка для 64-битных приложений (x64)...
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Blocked" /v "{596AB062-B4D2-4215-9F74-E9109B0A8153}" /t REG_SZ /d "" /f >nul
echo [OK] Блокировка для x64 применена
echo.

echo [2/2] Блокировка для 32-битных приложений (x86/WOW6432Node)...
reg add "HKLM\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Shell Extensions\Blocked" /v "{596AB062-B4D2-4215-9F74-E9109B0A8153}" /t REG_SZ /d "" /f >nul
echo [OK] Блокировка для x86 применена
echo.

echo ================================================================================
echo               ГОТОВО! ПУНКТ "ВОССТАНОВИТЬ ПРЕДЫДУЩИЕ ВЕРСИИ" ЗАБЛОКИРОВАН
echo ================================================================================
echo.
echo Проверьте: ПКМ на любом файле - пункт должен исчезнуть.
echo Для возврата используйте скрипт "Восстановление пункта Восстановить предыдущие версии.bat"
echo.

echo.