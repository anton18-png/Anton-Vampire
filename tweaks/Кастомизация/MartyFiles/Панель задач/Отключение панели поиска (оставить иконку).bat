@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ ПАНЕЛИ ПОИСКА
echo                     (ОСТАВИТЬ ТОЛЬКО ИКОНКУ)
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo На панели задач Windows есть поле поиска, которое может быть в виде:
echo   - Полное поле поиска (занимает много места)
echo   - Только иконка (компактный вид)
echo   - Полностью скрыто
echo.
echo Данный скрипт НАСТРАИВАЕТ ПОИСК В ВИДЕ ТОЛЬКО ИКОНКИ
echo (компактный режим, но поиск остается доступным по клику).
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ЭКОНОМИТ МЕСТО НА ПАНЕЛИ ЗАДАЧ
echo [+] Поиск остается доступным (нажмите на иконку)
echo [+] Убирает громоздкое поле поиска
echo [+] Клавиша Win работает для открытия поиска
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Нужно на один клик больше для поиска
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для всех, кто хочет сэкономить место на панели задач
echo [2] Оптимальный баланс между функциональностью и пространством
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "TaskbarMn" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo               ГОТОВО! ПОИСК НАСТРОЕН В ВИДЕ ТОЛЬКО ИКОНКИ
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение панели поиска (поле поиска).bat"
echo.

echo.