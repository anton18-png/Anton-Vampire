@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ АНИМАЦИИ ПАНЕЛИ ЗАДАЧ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo При наведении на значки на панели задач Windows показывает анимации:
echo   - Подсветка значков
echo   - Всплывающие подсказки с анимацией
echo   - Плавное появление превью окон
echo.
echo Данный скрипт ОТКЛЮЧАЕТ ЭТИ АНИМАЦИИ для повышения производительности.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] СНИЖАЕТ НАГРУЗКУ НА GPU И CPU
echo [+] УСКОРЯЕТ ОТКЛИК ПАНЕЛИ ЗАДАЧ
echo [+] ДЕЛАЕТ ИНТЕРФЕЙС БОЛЕЕ ОТЗЫВЧИВЫМ
echo [+] ПОЛЕЗНО ДЛЯ СЛАБЫХ И СРЕДНИХ ПК
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Пропадают плавные анимации при наведении
echo [-] Интерфейс становится более "сухим"
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ОСОБЕННО РЕКОМЕНДУЕТСЯ ДЛЯ ГЕЙМЕРОВ
echo [2] Рекомендуется для слабых и средних ПК
echo [3] На мощных ПК разница незаметна
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "TaskbarAnimations" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo               ГОТОВО! АНИМАЦИЯ ПАНЕЛИ ЗАДАЧ ОТКЛЮЧЕНА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение анимации панели задач.bat"
echo.

echo.