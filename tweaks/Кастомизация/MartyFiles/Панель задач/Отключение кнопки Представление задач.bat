@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ОТКЛЮЧЕНИЕ КНОПКИ "ПРЕДСТАВЛЕНИЕ ЗАДАЧ"
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Кнопка "Представление задач" (Task View) находится на панели задач рядом
echo с кнопкой Пуск. Она позволяет создавать виртуальные рабочие столы и
echo просматривать все открытые окна.
echo.
echo Данный скрипт ПОЛНОСТЬЮ СКРЫВАЕТ эту кнопку с панели задач.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ОСВОБОЖДАЕТ МЕСТО НА ПАНЕЛИ ЗАДАЧ
echo [+] Убирает визуальный "мусор" для тех, кто не использует виртуальные столы
echo [+] Небольшое снижение нагрузки на систему
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Нельзя быстро открыть представление задач
echo [-] Нельзя быстро переключаться между виртуальными рабочими столами
echo [-] Клавиша Win+Tab продолжает работать (открывает представление задач)
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для геймеров и минималистов
echo [2] Если используете виртуальные рабочие столы - лучше не отключать
echo [3] Клавиша Win+Tab все еще работает, так что доступ к функции остается
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "ShowTaskViewButton" /t REG_DWORD /d 0 /f

echo.
echo ================================================================================
echo               ГОТОВО! КНОПКА "ПРЕДСТАВЛЕНИЕ ЗАДАЧ" СКРЫТА
echo ================================================================================
echo.
echo Для применения изменений перезапустите Проводник или перезагрузитесь.
echo Для возврата используйте скрипт "Включение кнопки Представление задач.bat"
echo.

echo.