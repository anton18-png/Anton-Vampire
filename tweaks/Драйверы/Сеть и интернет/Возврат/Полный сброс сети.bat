@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ПОЛНЫЙ СБРОС СЕТИ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Сбрасывает все сетевые настройки Windows до стандартных:
echo   - Сброс IP стека
echo   - Сброс IPv4 интерфейсов
echo   - Сброс IPv6 интерфейсов
echo   - Сброс TCP параметров
echo   - Сброс Winsock
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Исправляет большинство проблем с сетью
echo [+] Восстанавливает интернет после неудачных оптимизаций
echo [+] Устраняет ошибки DNS и DHCP
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Требует перезагрузки для полного применения
echo [-] Сбрасываются все пользовательские настройки сети
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запускайте при проблемах с интернетом
echo [2] После выполнения обязательно перезагрузитесь
echo [3] Возможно потребуется перенастроить VPN
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo [1/5] Сброс IP стека...
netsh int ip reset >nul 2>&1

echo [2/5] Сброс IPv4 интерфейсов...
netsh interface ipv4 reset >nul 2>&1

echo [3/5] Сброс IPv6 интерфейсов...
netsh interface ipv6 reset >nul 2>&1

echo [4/5] Сброс TCP параметров...
netsh interface tcp reset >nul 2>&1

echo [5/5] Сброс Winsock...
netsh winsock reset >nul 2>&1

echo.
echo ================================================================================
echo                    ГОТОВО! СЕТЕВЫЕ СТЕКИ СБРОШЕНЫ
echo ================================================================================
echo.
echo Рекомендуется перезагрузить компьютер.

echo.