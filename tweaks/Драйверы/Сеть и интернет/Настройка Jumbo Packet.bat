@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - НАСТРОЙКА JUMBO PACKET
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Устанавливает размер Jumbo Packet (MTU) для сетевых адаптеров.
echo Значение 1514 - стандартный размер Ethernet кадра.
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Стандартный размер совместим со всеми сетями
echo [+] Устраняет проблемы с фрагментацией пакетов
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Небольшое снижение производительности по сравнению с Jumbo Frames
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Оставляйте 1514 для максимальной совместимости
echo [2] Для Jumbo Frames нужно менять на 9000 только в локальной сети
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

for /f %%a in ('reg query "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Class\{4d36e972-e325-11ce-bfc1-08002be10318}" /v "*SpeedDuplex" /s ^| findstr "HKEY"') do (
    for /f %%i in ('reg query "%%a" /v "*JumboPacket" ^| findstr "HKEY"') do Reg.exe add "%%i" /v "*JumboPacket" /t REG_SZ /d "1514" /f >nul 2>&1
)

echo.
echo ================================================================================
echo                    ГОТОВО! JUMBO PACKET НАСТРОЕН
echo ================================================================================

echo.