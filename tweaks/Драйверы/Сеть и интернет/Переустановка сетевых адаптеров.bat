@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ПЕРЕУСТАНОВКА СЕТЕВЫХ АДАПТЕРОВ
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Удаляет и переустанавливает все сетевые адаптеры:
echo   - Удаление всех активных сетевых устройств
echo   - Автоматическое сканирование и установка
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] Полностью переустанавливает драйверы сетевых карт
echo [+] Исправляет глубокие проблемы с сетью
echo [+] Устраняет конфликты драйверов
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Интернет пропадет на время переустановки
echo [-] Может потребоваться ручная настройка IP-адресов
echo [-] VPN и статические IP могут сброситься
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Запускайте только при серьезных проблемах с сетью
echo [2] После выполнения перезагрузитесь
echo [3] Подготовьте драйверы сетевой карты (на всякий случай)
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo [1/2] Удаление сетевых адаптеров...
PowerShell -NoP -C "foreach ($dev in Get-PnpDevice -Class Net -Status 'OK') { pnputil /remove-device $dev.InstanceId }" >nul 2>&1

echo [2/2] Сканирование и установка устройств...
pnputil /scan-devices >nul 2>&1

echo.
echo ================================================================================
echo                ГОТОВО! СЕТЕВЫЕ АДАПТЕРЫ ПЕРЕУСТАНОВЛЕНЫ
echo ================================================================================
echo.
echo Рекомендуется перезагрузить компьютер.

echo.