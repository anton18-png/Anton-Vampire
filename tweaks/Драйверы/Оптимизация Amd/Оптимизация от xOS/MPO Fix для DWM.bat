@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ТВИК 6
echo                    MPO FIX ДЛЯ DWM
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo MPO (Multi-Plane Overlay) - это технология Windows, которая позволяет
echo различным приложениям выводить изображение напрямую на экран,
echo минуя композицию DWM (Desktop Window Manager).
echo.
echo ПРОБЛЕМА: MPO может вызывать проблемы с отображением (черные экраны,
echo мерцание, артефакты, подвисания) на некоторых видеокартах AMD Radeon.
echo.
echo Данный твик ВКЛЮЧАЕТ OverlayTestMode = 5 для DWM, что позволяет
echo отключить MPO через настройки реестра.
echo.
echo Значение OverlayTestMode:
echo   0 = MPO включен (стандарт)
echo   5 = MPO отключен (фикс проблем)
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ИСПРАВЛЯЕТ ЧЕРНЫЕ ЭКРАНЫ ПРИ ЗАПУСКЕ ИГР
echo [+] ИСПРАВЛЯЕТ МЕРЦАНИЕ И АРТЕФАКТЫ
echo [+] УСТРАНЯЕТ ПОДВИСАНИЯ ВИДЕОКАРТЫ
echo [+] РЕШАЕТ ПРОБЛЕМЫ С МНОГОМОНИТОРНЫМИ КОНФИГУРАЦИЯМИ
echo [+] УЛУЧШАЕТ СТАБИЛЬНОСТЬ ИГР НА AMD RADEON
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Может незначительно снизить производительность в некоторых ситуациях
echo [-] Отключает аппаратные оверлеи
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] Рекомендуется для видеокарт AMD Radeon RX 5000 и новее
echo [2] Запускайте если есть проблемы с черными экранами или мерцанием
echo [3] Для возврата используйте скрипт "Восстановление твика 6 AMD.bat"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

:: Проверка прав администратора
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [ОШИБКА] Запустите от имени Администратора!
    echo.
    exit /b 1
)

echo Установка OverlayTestMode = 5 для DWM...
reg add "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Dwm" /v "OverlayTestMode" /t REG_DWORD /d 5 /f >nul

echo.
echo ================================================================================
echo                    ГОТОВО! ТВИК 6 ВЫПОЛНЕН
echo ================================================================================
echo.
echo Что сделано:
echo   - OverlayTestMode установлен в 5 (MPO отключен)
echo.
echo Результат:
echo   - MPO (Multi-Plane Overlay) отключен
echo   - Черные экраны, мерцание и артефакты должны исчезнуть
echo   - Стабильность игр повышена
echo.
echo Для возврата используйте скрипт "Восстановление твика 6 AMD.bat"
echo.

echo.