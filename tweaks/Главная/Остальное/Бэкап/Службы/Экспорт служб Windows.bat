@echo off
chcp 1251 >nul
title Экспорт служб Windows (создание REG-бэкапа)
color 0A
chcp 65001 >nul

echo ============================================================
echo    xOS PLAYBOOK - ЭКСПОРТ НАСТРОЕК СЛУЖБ WINDOWS
echo ============================================================
echo.
echo Автор: xOS Playbook
echo Назначение: Создание резервной копии режимов запуска всех служб
echo.

echo ------------------------------------------------------------
echo ЧТО СЕЙЧАС ПРОИЗОЙДЕТ:
echo ------------------------------------------------------------
echo 1. Будет запущен файл Export-Services.ps1 (лежит рядом с батником)
echo 2. Скрипт прочитает реестр по пути HKLM\SYSTEM\CurrentControlSet\Services
echo 3. Найдет ВСЕ службы у которых есть параметр Start (0,1,2,3,4)
echo 4. Сохранит их названия и значения в REG-файл
echo 5. REG-файл появится в C:\Apps\Extreme\user_data\BackUp\ServicesBackup.reg
echo.

echo ------------------------------------------------------------
echo ЧТО ТАКОЕ Start (режим запуска службы):
echo ------------------------------------------------------------
echo Start=0 - Boot (загрузочный драйвер, стартует с ядром Windows)
echo Start=1 - System (системный драйвер, сразу после ядра)
echo Start=2 - Auto (автоматический запуск при загрузке Windows)
echo Start=3 - Manual (вручную, запускается когда нужна служба)
echo Start=4 - Disabled (отключена, не запускается вообще)
echo.
echo ВНИМАНИЕ: Будут сохранены ВСЕ службы без исключения!
echo          Даже отключенные и ручные - ВСЕ попадут в бэкап.
echo.

echo ------------------------------------------------------------
echo ЗАЧЕМ ЭТО ГЕЙМЕРУ / ОПТИМИЗАТОРУ:
echo ------------------------------------------------------------
echo - Делайте бэкап ПЕРЕД тем как начать отключать службы
echo - Если после отключений игра или программа перестала работать
echo - Просто запускаете этот REG-файл и ВСЕ службы возвращаются как были
echo - Можно сравнить "ДО" и "ПОСЛЕ" оптимизации (через блокнот)
echo.

echo ------------------------------------------------------------
echo ПОЧЕМУ НЕЛЬЗЯ ЗАПУСКАТЬ ЭТОТ REG-ФАЙЛ НА ЧУЖОМ ПК:
echo ------------------------------------------------------------
echo ПРИЧИНА 1: На чужом ПК другие службы и железо
echo            Вы можете отключить важную службу для звука/сети/видеокарты
echo.
echo ПРИЧИНА 2: У вас отключена служба X, а на чужом ПК она критически важна
echo            Например, служба печати - у вас нет принтера, а у друга есть
echo.
echo ПРИЧИНА 3: Системные драйверы могут отличаться
echo            На ноутбуке одни драйверы, на десктопе - другие
echo.
echo ПРИЧИНА 4: Версии Windows разные (Win10, Win11, LTSC, Home, Pro)
echo            У каждой версии свой набор служб и зависимостей
echo.
echo ВЫВОД: Этот REG-файл - ТОЛЬКО ДЛЯ ВАШЕГО ПК!
echo         Как ключ от квартиры - работает только у вас.
echo.

echo ------------------------------------------------------------
echo ПЛЮСЫ ЭТОГО ТВИКА:
echo ------------------------------------------------------------
echo [+] Полный бэкап - ничего не упустит
echo [+] Можно открыть блокнотом и посмотреть что отключено
echo [+] Легко откатить изменения обратно
echo [+] Не меняет систему, только читает реестр (безопасно)
echo [+] Занимает мало места (обычно 50-100 КБ)
echo.

echo ------------------------------------------------------------
echo МИНУСЫ ЭТОГО ТВИКА:
echo ------------------------------------------------------------
echo [-] Экспортирует ВСЕ службы (500-800 записей, много мусора)
echo [-] Не показывает человеческие имена, только системные коды
echo [-] Сам по себе не оптимизирует, только для бэкапа
echo [-] Если импортировать на другой ПК - можно убить систему
echo.

echo ------------------------------------------------------------
echo РЕКОМЕНДАЦИИ:
echo ------------------------------------------------------------
echo [1] ЗАПУСКАТЬ ТОЛЬКО ОТ ИМЕНИ АДМИНИСТРАТОРА
echo [2] Делать свежий бэкап ПЕРЕД каждой новой оптимизацией
echo [3] Хранить бэкапы с датой в имени (переименуйте вручную)
echo [4] Не передавать REG-файл другим людям
echo [5] Если сомневаетесь - сначала откройте REG-файл блокнотом
echo.

:: Получаем текущую дату и время в формате ГГГГ-ММ-ДД_ЧЧ-ММ-СС
:: Это нужно чтобы каждый бэкап имел уникальное имя и не затирался
echo [1] Получаем текущую дату и время для имени файла...
for /f "tokens=1-6 delims=.:/ " %%a in ('echo %date% %time%') do (
    set YYYY=%%c
    set MM=%%b
    set DD=%%a
    set HH=%%d
    set MIN=%%e
    set SEC=%%f
)

:: Обработка разных форматов даты в Windows (русский/английский)
if "%YYYY%"=="" (
    for /f "tokens=1-3 delims=.:/ " %%a in ('echo %date%') do (
        set DD=%%a
        set MM=%%b
        set YYYY=%%c
    )
    for /f "tokens=1-3 delims=:." %%a in ('echo %time%') do (
        set HH=%%a
        set MIN=%%b
        set SEC=%%c
    )
)

:: Убираем лишние пробелы и нули
set HH=%HH: =0%
set MIN=%MIN: =0%
set SEC=%SEC: =0%
set DD=%DD: =0%
set MM=%MM: =0%

:: Собираем дату и время в формате ГГГГ-ММ-ДД_ЧЧ-ММ-СС
set DATETIME=%YYYY%-%MM%-%DD%_%HH%-%MIN%-%SEC%
echo [OK] Дата и время: %DATETIME%
echo.

:: Формируем имя выходного REG-файла с датой и временем
set BACKUP_FILE=C:\Apps\Extreme\user_data\BackUp\ServicesBackup_%DATETIME%.reg
echo [2] Бэкап будет сохранен как: %BACKUP_FILE%
echo.

echo ------------------------------------------------------------
echo [4] СОЗДАНИЕ ПАПКИ (если её нет):
echo ------------------------------------------------------------
if not exist "C:\Apps\Extreme\user_data\BackUp" (
    echo Папка не найдена, создаю...
    mkdir "C:\Apps\Extreme\user_data\BackUp" 2>nul
    echo [OK] Папка создана
) else (
    echo [OK] Папка существует
)
echo.

echo ------------------------------------------------------------
echo [5] ЗАПУСК ЭКСПОРТА СЛУЖБ (может занять 10-30 секунд):
echo ------------------------------------------------------------
echo Запускаем PowerShell с файлом Export-Services.ps1
echo Параметр -FilePath: %BACKUP_FILE%
echo.

:: ОСНОВНАЯ КОМАНДА ЗАПУСКА - ЗДЕСЬ ДОБАВЛЕНА ДАТА В ИМЯ ФАЙЛА
powershell.exe -ExecutionPolicy Bypass -File "Export-Services.ps1" -FilePath "%BACKUP_FILE%"

if %errorLevel% equ 0 (
    color 0A
    echo.
    echo ------------------------------------------------------------
    echo [ГОТОВО] УСПЕШНО! БЭКАП СОЗДАН
    echo ------------------------------------------------------------
    echo.
    echo ПУТЬ К ФАЙЛУ:
    echo C:\Apps\Extreme\user_data\BackUp\ServicesBackup.reg
    echo.
    echo РАЗМЕР ФАЙЛА:
    dir "C:\Apps\Extreme\user_data\BackUp\ServicesBackup.reg" 2>nul | find "ServicesBackup.reg"
    echo.
    echo ------------------------------------------------------------
    echo КАК ВОССТАНОВИТЬ СЛУЖБЫ ИЗ ЭТОГО БЭКАПА:
    echo ------------------------------------------------------------
    echo - Найти файл ServicesBackup.reg
    echo - Два раза кликнуть по нему
    echo - Нажать "Да" в предупреждении
    echo - Перезагрузить компьютер
    echo.
    echo ------------------------------------------------------------
    echo ПРЕДУПРЕЖДЕНИЕ ОТ xOS PLAYBOOK:
    echo ------------------------------------------------------------
    echo Если вы ДО ЭТОГО уже отключали службы - они сохранятся
    echo в бэкап как "отключено". Делайте бэкап ДО начала оптимизации!
    echo.
) else (
    color 0C
    echo.
    echo ------------------------------------------------------------
    echo [ОШИБКА] ЧТО-ТО ПОШЛО НЕ ТАК
    echo ------------------------------------------------------------
    echo.
    echo ВОЗМОЖНЫЕ ПРИЧИНЫ:
    echo 1. Файл Export-Services.ps1 не найден в папке с батником
    echo 2. Не хватает прав на запись в C:\Apps\Extreme\user_data\BackUp
    echo 3. PowerShell заблокирован или отключен
    echo.
    echo РЕШЕНИЕ:
    echo - Проверьте что Export-Services.ps1 лежит рядом с этим батником
    echo - Запустите от имени администратора
    echo - Создайте папку вручную: C:\Apps\Extreme\user_data\BackUp
    echo.
)
