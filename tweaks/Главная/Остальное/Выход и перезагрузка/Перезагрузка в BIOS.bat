@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ПЕРЕЗАГРУЗКА В BIOS/UEFI
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Данный скрипт ПЕРЕЗАГРУЖАЕТ КОМПЬЮТЕР СРАЗУ В BIOS/UEFI.
echo.
echo Что произойдет:
echo   - Компьютер перезагрузится
echo   - При загрузке автоматически войдет в BIOS/UEFI
echo   - Можно будет изменить настройки: загрузку с флешки, разгон, виртуализацию
echo.
echo Команда: shutdown /r /fw /t 0
echo   /r - перезагрузка
echo   /fw - загрузиться в прошивку (BIOS/UEFI)
echo   /t 0 - без задержки (0 секунд)
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] БЫСТРЫЙ ВХОД В BIOS/UEFI без нажатия клавиш (F2, Del, F10)
echo [+] УДОБНО для пользователей, которые не знают клавишу входа
echo [+] ПОЛЕЗНО при установке Windows с флешки
echo [+] ПОЛЕЗНО при настройке виртуализации (VT-x, AMD-V)
echo [+] ПОЛЕЗНО при разгоне процессора и памяти
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] НЕ СОХРАНЯЮТСЯ НЕСОХРАНЕННЫЕ ДАННЫЕ (закройте все программы!)
echo [-] Не работает на очень старых компьютерах (без UEFI)
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] СОХРАНИТЕ ВСЕ ДАННЫЕ перед запуском!
echo [2] Закройте все программы перед запуском
echo [3] Скрипт НЕЛЬЗЯ ОТМЕНИТЬ - сразу начнется перезагрузка
echo [4] Проверьте поддержку /fw: shutdown /? | find "/fw"
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

shutdown /r /fw /t 0
shutdown -r -fw -t 0
