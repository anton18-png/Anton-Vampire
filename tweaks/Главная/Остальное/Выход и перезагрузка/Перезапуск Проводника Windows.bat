@echo off
chcp 65001 >nul

echo ================================================================================
echo                 xOS PLAYBOOK - ПЕРЕЗАПУСК ПРОВОДНИКА WINDOWS
echo ================================================================================
echo.
echo ОПИСАНИЕ:
echo ================================================================================
echo Перезапуск Проводника Windows необходим для применения многих изменений
echo реестра, особенно визуальных настроек и настроек контекстного меню.
echo.
echo Данный скрипт ВЫПОЛНЯЕТ ПЕРЕЗАПУСК ПРОВОДНИКА:
echo   - Завершает процесс explorer.exe
echo   - Запускает explorer.exe заново
echo.
echo ================================================================================
echo ПЛЮСЫ:
echo ================================================================================
echo [+] ПРИМЕНЯЕТ ИЗМЕНЕНИЯ РЕЕСТРА без перезагрузки ПК
echo [+] ВОССТАНАВЛИВАЕТ РАБОТУ ПРОВОДНИКА после сбоев
echo [+] ПЕРЕЗАПУСКАЕТ КОНТЕКСТНОЕ МЕНЮ и панель задач
echo.
echo ================================================================================
echo МИНУСЫ:
echo ================================================================================
echo [-] Закрывает все открытые окна Проводника
echo [-] Панель задач временно пропадает на 1-2 секунды
echo.
echo ================================================================================
echo РЕКОМЕНДАЦИИ:
echo ================================================================================
echo [1] ЗАПУСКАЙТЕ ПОСЛЕ ВНЕСЕНИЯ ИЗМЕНЕНИЙ В РЕЕСТР
echo [2] Сохраните все открытые файлы перед запуском
echo [3] Альтернатива - перезагрузка компьютера
echo.
echo ================================================================================
echo ПРИМЕНЕНИЕ:
echo ================================================================================

echo [1/2] Завершение процесса Проводника (explorer.exe)...
taskkill /f /im explorer.exe >nul 2>&1
echo [OK] Проводник завершен
echo.

echo [2/2] Запуск Проводника Windows...
start explorer.exe
echo [OK] Проводник запущен
echo.

echo ================================================================================
echo                    ГОТОВО! ПРОВОДНИК ПЕРЕЗАПУЩЕН
echo ================================================================================
echo.
echo Все изменения реестра, требующие перезапуска Проводника, применены.
echo.

echo.